{
  "name": "atlas-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium --only-shell",
    "dev": "vite",
    "dev:fake": "vite --mode fake",
    "gen:types": "node scripts/gen-types.mjs",
    "typecheck": "npm run gen:types && tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "build": "vite build",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "tauri": "TAURI_APP_PATH=../src-tauri TAURI_FRONTEND_PATH=. tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@json-render/core": "^0.23.2",
    "@json-render/react": "^0.23.2",
    "@json-render/shadcn": "^0.23.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2.12.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "culori": "^4.0.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.76.0",
    "mermaid": "^12.3.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10",
    "@playwright/test": "1.57.0",
    "@tauri-apps/cli": "^2.12.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/culori": "^4.0.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "jsdom": "^31.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "playwright-core": "1.57.0"
  }
}
